{
  "verify": [
    "make fmt-check",
    {
      "cmd": "make lint",
      "timeoutMs": 1800000
    },
    {
      "cmd": "make corpus",
      "timeoutMs": 1800000
    },
    {
      "cmd": "make test",
      "timeoutMs": 2700000
    },
    "make crate-checks",
    "make cleanroom-selftest"
  ],
  "extraVerify": {
    "tools/": [
      "make tools-check"
    ],
    "docs/DESIGN.md": [
      "make design-check"
    ],
    "fuzz/": [
      {
        "cmd": "make fuzz-check",
        "timeoutMs": 1800000
      }
    ],
    "crates/cleanflate/src/": [
      {
        "cmd": "make proptest-3k",
        "timeoutMs": 3600000
      },
      {
        "cmd": "make fuzz-smoke-decoder",
        "timeoutMs": 2400000
      }
    ]
  },
  "build": [
    "cargo build --workspace --release"
  ],
  "baseBranch": "main",
  "branchPrefix": "build/",
  "maxRounds": 6,
  "maxRoundsHard": 6,
  "constraints": [
    {
      "id": "no-unsafe-token-in-cleanflate",
      "description": "SPEC §3 / C1: zero unsafe anywhere in crates/cleanflate. The bare word is banned in code, comments and docs alike so the CI grep and this rule agree.",
      "paths": [
        "crates/cleanflate/"
      ],
      "pattern": "\\bunsafe\\b",
      "shouldMatch": [
        "unsafe { buf.get_unchecked(i) }",
        "pub unsafe fn read(p: *const u8) -> u8 {",
        "unsafe impl Send for Inflater {}",
        "// this path is unsafe for short inputs"
      ],
      "shouldNotMatch": [
        "#![forbid(unsafe_code)]",
        "let unsafety_note = 1;",
        "// memory safety is enforced by the compiler"
      ]
    },
    {
      "id": "no-panicking-calls-in-cleanflate-lib",
      "description": "SPEC §3 / C4: no panics reachable from the public API. Library code (crates/cleanflate/src/ except src/tests/) never calls unwrap/expect or the panicking macros, including assert!/assert_eq!/assert_ne!. debug_assert! is allowed.",
      "paths": [
        "crates/cleanflate/src/"
      ],
      "exclude": [
        "crates/cleanflate/src/tests/"
      ],
      "pattern": "\\.unwrap\\(\\)|\\.expect\\(|\\b(panic|unreachable|todo|unimplemented|assert|assert_eq|assert_ne)!\\s*[\\(\\[\\{]",
      "shouldMatch": [
        "let v = x.unwrap();",
        "let v = x.expect(\"present\");",
        "panic!(\"bad state\");",
        "_ => unreachable!(),",
        "todo!()",
        "unimplemented!()",
        "assert!(n < 16);",
        "assert_eq!(a, b);",
        "assert_ne!(a, b);",
        "panic! {\"x\"}",
        "const _: () = assert!(FAST_LOOP_MIN_OUTPUT >= 258);"
      ],
      "shouldNotMatch": [
        "let v = x.unwrap_or(0);",
        "let v = x.unwrap_or_default();",
        "debug_assert!(n < 16);",
        "debug_assert_eq!(a, b);",
        "let v = x.ok_or(Error::Truncated)?;",
        "// never panics on any input"
      ]
    },
    {
      "id": "no-inline-tests-in-cleanflate-src",
      "description": "C6: unit tests for crates/cleanflate live only under crates/cleanflate/src/tests/ (declared once in lib.rs), so the panic-call rule above can exclude them by path.",
      "paths": [
        "crates/cleanflate/src/"
      ],
      "exclude": [
        "crates/cleanflate/src/tests/",
        "crates/cleanflate/src/lib.rs"
      ],
      "pattern": "#\\[\\s*(cfg\\s*\\(\\s*test\\s*\\)|test)\\s*\\]",
      "shouldMatch": [
        "#[cfg(test)]",
        "    #[cfg(test)]",
        "#[test]",
        "    #[test]"
      ],
      "shouldNotMatch": [
        "#[cfg(feature = \"stats\")]",
        "#[cfg_attr(not(any(test, feature = \"test-hooks\")), allow(dead_code))]",
        "#[inline]",
        "// unit tests live in src/tests/"
      ]
    },
    {
      "id": "no-io-or-nondeterminism-in-cleanflate",
      "description": "C7: the library is a pure function of its input bytes and options: no clocks (stats count calls, never time), no hashing randomness, no filesystem, network, process or environment access under crates/cleanflate/src/ (unit-test tree excluded).",
      "paths": [
        "crates/cleanflate/src/"
      ],
      "exclude": [
        "crates/cleanflate/src/tests/"
      ],
      "pattern": "\\b(SystemTime|Instant|HashMap|HashSet|RandomState|thread_rng)\\b|\\bstd::(net|process|env|fs|thread|time)\\b",
      "shouldMatch": [
        "use std::collections::HashMap;",
        "let t = std::time::Instant::now();",
        "use std::time::SystemTime;",
        "use std::time::Duration;",
        "use std::fs::File;",
        "let v = std::env::var(\"X\");",
        "use std::net::TcpStream;",
        "std::thread::spawn(f);"
      ],
      "shouldNotMatch": [
        "use std::io::Write;",
        "use core::cmp::min;",
        "let histogram = [0u16; 16];",
        "use std::error::Error as StdError;",
        "pub table_builds: u64,"
      ]
    },
    {
      "id": "no-global-state-in-cleanflate",
      "description": "C7: no global mutable or lazily-initialised state in cleanflate library code. Stats counters live in the decoder instance; constant tables are const/static data built by const fn.",
      "paths": [
        "crates/cleanflate/src/"
      ],
      "exclude": [
        "crates/cleanflate/src/tests/"
      ],
      "pattern": "\\bthread_local!|\\bstd::sync::atomic\\b|\\bAtomic(U|I)(8|16|32|64|size)\\b|\\bstatic\\s+mut\\b|\\b(OnceLock|LazyLock|OnceCell|Mutex|RwLock)\\b",
      "shouldMatch": [
        "thread_local! { static HITS: Cell<u64> = Cell::new(0); }",
        "use std::sync::atomic::{AtomicU64, Ordering};",
        "static COUNTER: AtomicU64 = AtomicU64::new(0);",
        "static mut HITS: u64 = 0;",
        "static TABLE: OnceLock<Vec<u32>> = OnceLock::new();",
        "static STATS: Mutex<Stats> = Mutex::new(Stats::new());"
      ],
      "shouldNotMatch": [
        "static CRC32_TABLES: [[u32; 256]; CRC32_SLICES] = build_crc32_tables();",
        "const FIXED_LITLEN_LENGTHS: [u8; 288] = fixed_litlen_lengths();",
        "pub struct Stats {",
        "self.stats.literals = self.stats.literals.saturating_add(1);"
      ]
    },
    {
      "id": "tunables-defined-only-in-config",
      "description": "C8 / SPEC §3: every tunable number (phase-1 limits and table widths, phase-2 fast-loop margins, one-shot sizing and CRC slicing, and the derived one-shot expansion bound) is given a value only in crates/cleanflate/src/config.rs; everywhere else refers to the constant by name. A task that adds a tunable names it in config.rs; the reviewer checks it is not redefined elsewhere.",
      "paths": [
        "crates/",
        "fuzz/"
      ],
      "exclude": [
        "crates/cleanflate/src/config.rs"
      ],
      "pattern": "\\b(DEFAULT_MAX_OUTPUT|DEFAULT_MAX_GZIP_FIELD|DEFAULT_MAX_GZIP_HEADERS|LITLEN_TABLE_BITS|DIST_TABLE_BITS|FAST_LOOP_MIN_INPUT|FAST_LOOP_MIN_OUTPUT|ONESHOT_GROWTH_FLOOR|ONESHOT_INITIAL_RATIO|ONESHOT_MAX_PREALLOC|MAX_DEFLATE_EXPANSION|CRC32_SLICES)\\b\\s*(:\\s*[A-Za-z0-9_:<>]+\\s*)?=\\s*[-0-9(]",
      "shouldMatch": [
        "pub const DEFAULT_MAX_OUTPUT: u64 = 1 << 30;",
        "const LITLEN_TABLE_BITS: u32 = 10;",
        "let DIST_TABLE_BITS = 8;",
        "pub(crate) const DEFAULT_MAX_GZIP_FIELD: usize = (64 * 1024);",
        "pub const DEFAULT_MAX_GZIP_HEADERS: usize = 1024;",
        "pub(crate) const FAST_LOOP_MIN_INPUT: usize = 16;",
        "const FAST_LOOP_MIN_OUTPUT: usize = 258;",
        "let ONESHOT_GROWTH_FLOOR = 32768;",
        "pub(crate) const ONESHOT_INITIAL_RATIO: usize = 4;",
        "const ONESHOT_MAX_PREALLOC: usize = 64 << 20;",
        "pub(crate) const CRC32_SLICES: usize = 8;",
        "pub(crate) const MAX_DEFLATE_EXPANSION: usize = 1032;"
      ],
      "shouldNotMatch": [
        "let bits = config::LITLEN_TABLE_BITS;",
        "if produced == DEFAULT_MAX_OUTPUT {",
        "max_output: DEFAULT_MAX_OUTPUT,",
        "pub use config::{DEFAULT_MAX_OUTPUT, DEFAULT_MAX_GZIP_FIELD};",
        "if input.len() - pos >= FAST_LOOP_MIN_INPUT {",
        "let min_out = FAST_LOOP_MIN_OUTPUT.max(MAX_MATCH_LEN);",
        "if CRC32_SLICES == 8 {",
        "const MIN_OUT: usize = FAST_LOOP_MIN_OUTPUT;",
        "let possible = input.len().saturating_mul(MAX_DEFLATE_EXPANSION);"
      ]
    },
    {
      "id": "option-defaults-not-literal",
      "description": "C8: Options fields that carry a tunable default are initialised from the config.rs constant, never from a literal.",
      "paths": [
        "crates/cleanflate/src/"
      ],
      "exclude": [
        "crates/cleanflate/src/config.rs",
        "crates/cleanflate/src/tests/"
      ],
      "pattern": "\\b(max_output|max_gzip_field|max_gzip_headers)\\s*(:|=)\\s*[0-9(]",
      "shouldMatch": [
        "max_output: 1 << 30,",
        "max_gzip_field: 65536,",
        "options.max_output = 1_073_741_824;",
        "let max_output = (1u64 << 30);",
        "max_gzip_headers: 1024,"
      ],
      "shouldNotMatch": [
        "max_output: config::DEFAULT_MAX_OUTPUT,",
        "pub max_output: u64,",
        "if self.total_out >= self.max_output {",
        "max_gzip_field: DEFAULT_MAX_GZIP_FIELD,",
        "max_gzip_headers: DEFAULT_MAX_GZIP_HEADERS,"
      ]
    },
    {
      "id": "no-output-limit-literal",
      "description": "C8: the 1 GiB default output limit appears as a number only in crates/cleanflate/src/config.rs; tests, fuzz targets, examples and the oracle use cleanflate::DEFAULT_MAX_OUTPUT.",
      "paths": [
        "crates/",
        "fuzz/"
      ],
      "exclude": [
        "crates/cleanflate/src/config.rs"
      ],
      "pattern": "\\b1\\s*<<\\s*30\\b|\\b1_?073_?741_?824\\b|\\b1024\\s*\\*\\s*1024\\s*\\*\\s*1024\\b",
      "shouldMatch": [
        "let limit = 1 << 30;",
        "const LIMIT: u64 = 1073741824;",
        "limit: 1_073_741_824,",
        "let n = 1024 * 1024 * 1024;"
      ],
      "shouldNotMatch": [
        "let limit = cleanflate::DEFAULT_MAX_OUTPUT;",
        "let x = 1 << 3;",
        "let y = 11 << 30;",
        "let mib = 1024 * 1024;"
      ]
    },
    {
      "id": "libz-only-in-oracle",
      "description": "C9: libz-sys is linked and named only inside crates/oracle. cleanflate (including its profiling example) and the fuzz crate reach C zlib only through oracle's safe wrappers. fuzz/Cargo.lock is exempt: it is a lockfile and necessarily lists oracle's transitive libz-sys pin.",
      "paths": [
        "crates/cleanflate/",
        "fuzz/"
      ],
      "exclude": [
        "fuzz/Cargo.lock"
      ],
      "pattern": "libz[-_]sys",
      "shouldMatch": [
        "use libz_sys::inflate;",
        "libz-sys = { version = \"1\", features = [\"static\"] }",
        "extern crate libz_sys;"
