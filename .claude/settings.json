{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|WebFetch|WebSearch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/cleanroom/guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/cleanroom/log.py\""
          }
        ]
      }
    ]
  }
}
